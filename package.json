{
  "name": "playwright-saucedemo-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "End-to-end tests for SauceDemo built with Playwright, TypeScript and the Page Object Model",
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.0"
  }
}
